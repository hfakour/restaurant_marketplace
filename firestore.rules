// Cloud Firestore security rules for the authentication feature.
//
// These rules restrict access to user profile documents so that only the
// authenticated user can read or write their own document.  All other
// collections and documents are denied by default.  Update or extend these
// rules according to your application's data model.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile document.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access to documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}